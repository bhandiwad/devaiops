{
  "realm": "platform",
  "enabled": true,
  "roles": {
    "realm": [
      {"name": "platform_admin"},
      {"name": "tenant_admin"},
      {"name": "tenant_operator"},
      {"name": "tenant_developer"},
      {"name": "tenant_viewer"}
    ]
  },
  "clients": [
    {
      "clientId": "platform-api",
      "enabled": true,
      "publicClient": false,
      "secret": "platform-api-secret",
      "redirectUris": ["http://localhost:8000/*"],
      "webOrigins": ["*"]
    },
    {
      "clientId": "backstage",
      "enabled": true,
      "publicClient": true,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["*"]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "credentials": [{"type": "password", "value": "admin", "temporary": false}],
      "realmRoles": ["platform_admin"]
    },
    {
      "username": "tenantop",
      "enabled": true,
      "credentials": [{"type": "password", "value": "tenantop", "temporary": false}],
      "realmRoles": ["tenant_operator"],
      "attributes": {
        "tenant_roles": ["{\"tenant-acme\":[\"tenant_operator\"]}"]
      }
    }
  ]
}
